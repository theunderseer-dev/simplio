CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
ENABLE_USER_SCRIPT_SANDBOXING = NO
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Simplio/Info.plist
INFOPLIST_KEY_UILaunchScreen_Generation = YES
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MARKETING_VERSION = 1.0
OTHER_LDFLAGS = $(inherited) -framework SimplioKit
PRODUCT_BUNDLE_IDENTIFIER = com.theunderseer.simplio
PRODUCT_NAME = $(TARGET_NAME)
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2

FIREBASE_PROJECT_ID =
FIREBASE_API_KEY =
#include? "Firebase.local.xcconfig"
